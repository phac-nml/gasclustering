nextflow_process {
    name "Test Process APPEND_METADATA"
    script "modules/local/appendmetadata/main.nf"
    process "APPEND_METADATA"

    test("Test dropping of empty metadata columns with default names") {
        tag "APPEND_METADATA_drop_metadata"
        when {
            process {
                """
                input[0] = Channel.of(file("$baseDir/tests/data/clusters/expected_clusters.tsv"))
                input[1] = Channel.of([
                    ["sample1", "sample1", "1.1", "1.2", "1.3", "1.4", "1.5", "1.6", "1.7", "1.8", "", "", "", "", "", "", "",""],
                    ["sample2", "sample2", "2.1", "2.2", "2.3", "2.4", "2.5", "2.6", "2.7", "2.8", "", "", "", "", "", "", "",""],
                    ["sample3", "sample3", "3.1", "3.2", "3.3", "3.4", "3.5", "3.6", "3.7", "3.8", "", "", "", "", "", "", "",""]
                ])
                input[2] = Channel.of([
                    "sample",
                    "metadata_1",
                    "metadata_2",
                    "metadata_3",
                    "metadata_4",
                    "metadata_5",
                    "metadata_6",
                    "metadata_7",
                    "metadata_8",
                    "metadata_9",
                    "metadata_10",
                    "metadata_11",
                    "metadata_12",
                    "metadata_13",
                    "metadata_14",
                    "metadata_15",
                    "metadata_16"
                ])
                """
            }

            params {
                outdir = "append_results"
            }
        }

        then {
            assert process.success
            // Check that the output drops default metadata fields 9-16
            def append_file = path("$launchDir/append_results/append/clusters_and_metadata.tsv")
            assert append_file.exists()
            assert append_file.text.contains("id\taddress\tlevel_1\tlevel_2\tlevel_3\tsample\tmetadata_1\tmetadata_2\tmetadata_3\tmetadata_4\tmetadata_5\tmetadata_6\tmetadata_7\tmetadata_8\n")
        }
    }
    test("Test keeping empty metadata columns with custom names") {
        tag "APPEND_METADATA_keep_all_metadata"
        when {
            process {
                """
                input[0] = Channel.of(file("$baseDir/tests/data/clusters/expected_clusters.tsv"))
                input[1] = Channel.of([
                    ["sample1", "sample1", "1.1", "1.2", "1.3", "1.4", "1.5", "1.6", "1.7", "1.8", "", "", "", "", "", "", "",""],
                    ["sample2", "sample2", "2.1", "2.2", "2.3", "2.4", "2.5", "2.6", "2.7", "2.8", "", "", "", "", "", "", "",""],
                    ["sample3", "sample3", "3.1", "3.2", "3.3", "3.4", "3.5", "3.6", "3.7", "3.8", "", "", "", "", "", "", "",""]
                ])
                input[2] = Channel.of([
                    "sample",
                    "metadata_a",
                    "metadata_b",
                    "metadata_c",
                    "metadata_d",
                    "metadata_e",
                    "metadata_f",
                    "metadata_g",
                    "metadata_h",
                    "metadata_i",
                    "metadata_j",
                    "metadata_k",
                    "metadata_l",
                    "metadata_m",
                    "metadata_n",
                    "metadata_o",
                    "metadata_p"
                ])
                """
            }

            params {
                outdir = "append_results"
            }
        }

        then {
            assert process.success
            // Check that the output drops default metadata fields 9-16
            def append_file = path("$launchDir/append_results/append/clusters_and_metadata.tsv")
            assert append_file.exists()
            assert append_file.text.contains("id\taddress\tlevel_1\tlevel_2\tlevel_3\tsample\tmetadata_a\tmetadata_b\tmetadata_c\tmetadata_d\tmetadata_e\tmetadata_f\tmetadata_g\tmetadata_h\tmetadata_i\tmetadata_j\tmetadata_k\tmetadata_l\tmetadata_m\tmetadata_n\tmetadata_o\tmetadata_p\n")
        }
    }
    test("Test keeping of empty metadata columns with non-default numeric names 0 and 25") {
        tag "APPEND_METADATA_keep_metadata_0_25"
        // Metadata columns "metadata_0" and "metadata_25" are kept because the default metadata columns 1-24 are the only ones dropped
        when {
            process {
                """
                input[0] = Channel.of(file("$baseDir/tests/data/clusters/expected_clusters.tsv"))
                input[1] = Channel.of([
                    ["sample1", "sample1", "1.1", "1.2", "1.3", "1.4", "1.5", "1.6", "1.7", "1.8", "", "", "", "", "", "", "",""],
                    ["sample2", "sample2", "2.1", "2.2", "2.3", "2.4", "2.5", "2.6", "2.7", "2.8", "", "", "", "", "", "", "",""],
                    ["sample3", "sample3", "3.1", "3.2", "3.3", "3.4", "3.5", "3.6", "3.7", "3.8", "", "", "", "", "", "", "",""]
                ])
                input[2] = Channel.of([
                    "sample",
                    "metadata_1",
                    "metadata_2",
                    "metadata_3",
                    "metadata_4",
                    "metadata_5",
                    "metadata_6",
                    "metadata_7",
                    "metadata_8",
                    "metadata_0",
                    "metadata_10",
                    "metadata_11",
                    "metadata_12",
                    "metadata_13",
                    "metadata_14",
                    "metadata_15",
                    "metadata_25"
                ])
                """
            }

            params {
                outdir = "append_results"
            }
        }

        then {
            assert process.success
            // Check that the output drops default metadata fields 9-16
            def append_file = path("$launchDir/append_results/append/clusters_and_metadata.tsv")
            assert append_file.exists()
            assert append_file.text.contains("id\taddress\tlevel_1\tlevel_2\tlevel_3\tsample\tmetadata_1\tmetadata_2\tmetadata_3\tmetadata_4\tmetadata_5\tmetadata_6\tmetadata_7\tmetadata_8\tmetadata_0\tmetadata_25\n")
        }
    }
}
